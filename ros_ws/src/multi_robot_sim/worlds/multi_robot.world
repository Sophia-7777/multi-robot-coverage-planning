<?xml version="1.0"?>

<sdf version="1.6">
  <world name="multi_robot_world">

    <!-- =========================
         Sun
         ========================= -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- =========================
         Ground
         ========================= -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- =========================
         Physics
         ========================= -->
    <physics type="ode">
      <real_time_update_rate>1000.0</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>

      <ode>
        <solver>
          <type>quick</type>
          <iters>150</iters>
          <precon_iters>0</precon_iters>
          <sor>1.400000</sor>
          <use_dynamic_moi_rescaling>1</use_dynamic_moi_rescaling>
        </solver>

        <constraints>
          <cfm>0.00001</cfm>
          <erp>0.2</erp>
          <contact_max_correcting_vel>2000.000000</contact_max_correcting_vel>
          <contact_surface_layer>0.01000</contact_surface_layer>
        </constraints>
      </ode>
    </physics>


    <!-- =====================================================
         OUTER WALLS
         Environment: approximately 20m x 15m
         ===================================================== -->

    <model name="wall_north">
      <static>true</static>
      <pose>0 7.5 1.0 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>40 0.4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>40 0.4 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <model name="wall_south">
      <static>true</static>
      <pose>0 -7.5 1.0 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>40 0.4 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>40 0.4 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <model name="wall_east">
      <static>true</static>
      <pose>10 0 1.0 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 30 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 30 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <model name="wall_west">
      <static>true</static>
      <pose>-10 0 1.0 0 0 0</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.4 30 2</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.4 30 2</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- =====================================================
         SMALL RANDOM INTERNAL OBSTACLES
         All obstacles have different dimensions
         ===================================================== -->

    <!-- 01 -->
    <model name="obstacle_01">
      <static>true</static>
      <pose>-6.8 4.8 0.4 0 0 0.35</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.4 0.8 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.4 0.8 0.8</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 02 -->
    <model name="obstacle_02">
      <static>true</static>
      <pose>5.8 2.2 0.35 0 0 -0.65</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.9 1.5 0.7</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.9 1.5 0.7</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 03 -->
    <model name="obstacle_03">
      <static>true</static>
      <pose>-2.2 -2.8 0.45 0 0 1.05</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.7 1.0 0.9</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.7 1.0 0.9</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 04 -->
    <model name="obstacle_04">
      <static>true</static>
      <pose>1.8 5.0 0.4 0 0 -0.25</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>1.1 0.7 0.8</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1.1 0.7 0.8</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- 05 -->
    <model name="obstacle_05">
      <static>true</static>
      <pose>6.5 -4.8 0.3 0 0 0.75</pose>
      <link name="link">

        <collision name="collision">
          <geometry>
            <box>
              <size>0.8 1.6 0.6</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>0.8 1.6 0.6</size>
            </box>
          </geometry>
        </visual>

      </link>
    </model>


    <!-- =====================================================
         Scene
         ===================================================== -->

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>


    <!-- =====================================================
         Camera
         ===================================================== -->

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 0 30 0 1.5708 0</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>

