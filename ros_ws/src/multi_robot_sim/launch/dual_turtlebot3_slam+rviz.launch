<?xml version="1.0"?>

<launch>

  <!-- ========================================================= -->
  <!-- Robot 1 SLAM                                              -->
  <!-- ========================================================= -->

  <group ns="robot1">

    <node pkg="gmapping"
          type="slam_gmapping"
          name="slam_gmapping"
          output="screen">

      <!-- Laser scan -->
      <remap from="scan" to="/robot1/scan"/>

      <!-- TF frames -->
      <param name="base_frame" value="robot1/base_footprint"/>
      <param name="odom_frame" value="robot1/odom"/>
      <param name="map_frame"  value="robot1/map"/>

      <!-- Map -->
      <param name="map_update_interval" value="2.0"/>
      <param name="delta" value="0.05"/>

      <!-- Laser -->
      <param name="maxRange" value="3.5"/>
      <param name="maxUrange" value="3.0"/>

      <!-- Scan matching -->
      <param name="linearUpdate" value="0.2"/>
      <param name="angularUpdate" value="0.1"/>

      <!-- Particle filter -->
      <param name="particles" value="30"/>

      <!-- Motion model -->
      <param name="srr" value="0.01"/>
      <param name="srt" value="0.02"/>
      <param name="str" value="0.01"/>
      <param name="stt" value="0.02"/>

      <!-- Map bounds -->
      <param name="xmin" value="-10.0"/>
      <param name="ymin" value="-10.0"/>
      <param name="xmax" value="10.0"/>
      <param name="ymax" value="10.0"/>

    </node>

  </group>


  <!-- ========================================================= -->
  <!-- Robot 2 SLAM                                              -->
  <!-- ========================================================= -->

  <group ns="robot2">

    <node pkg="gmapping"
          type="slam_gmapping"
          name="slam_gmapping"
          output="screen">

      <!-- Laser scan -->
      <remap from="scan" to="/robot2/scan"/>

      <!-- TF frames -->
      <param name="base_frame" value="robot2/base_footprint"/>
      <param name="odom_frame" value="robot2/odom"/>
      <param name="map_frame"  value="robot2/map"/>

      <!-- Map -->
      <param name="map_update_interval" value="2.0"/>
      <param name="delta" value="0.05"/>

      <!-- Laser -->
      <param name="maxRange" value="3.5"/>
      <param name="maxUrange" value="3.0"/>

      <!-- Scan matching -->
      <param name="linearUpdate" value="0.2"/>
      <param name="angularUpdate" value="0.1"/>

      <!-- Particle filter -->
      <param name="particles" value="30"/>

      <!-- Motion model -->
      <param name="srr" value="0.01"/>
      <param name="srt" value="0.02"/>
      <param name="str" value="0.01"/>
      <param name="stt" value="0.02"/>

      <!-- Map bounds -->
      <param name="xmin" value="-10.0"/>
      <param name="ymin" value="-10.0"/>
      <param name="xmax" value="10.0"/>
      <param name="ymax" value="10.0"/>

    </node>

  </group>


  <!-- ========================================================= -->
  <!-- RViz                                                       -->
  <!-- ========================================================= -->

  <node pkg="rviz"
        type="rviz"
        name="rviz"
        output="screen"/>

</launch>
